;; lg-pd-color — the portable Clojure port of the Python LangGraph server
;; (ADR-2606280030), scoped to this sub-project (it does NOT touch the repo root).
;;
;;   src   — lg-pd-color.* namespaces (graphs + server + dispatch)
;;   test  — lg-pd-color.smoke-test, lg-pd-color.contract-test
;;
;; The suite runs on BOTH runtimes and the runner is `run_tests.cljk`:
;;
;;   kbb --backend sci run_tests.cljk      nbb first (the workspace's script host), JVM after
;;   kbb -M:test         the JVM half on its own
;;
;; The dependency is `kotoba-lang/langgraph`, which is where this workspace
;; registers the library (west path orgs/kotoba-lang/langgraph). The `bb.edn`
;; this file replaces named `com-junkawasaki/langgraph-clj` — the pre-rename
;; coordinate, from before the no-`-clj`-suffix rule — and declared `bb` as the
;; only way to run the suite, which is the script host this workspace retired.
;; The sha below is langgraph's default-branch tip, so the pin is reachable.
{:paths ["src"]
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.langgraph"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}}}
